lmms-web: The LADSPA libraries LMMS bundles (CMT, CAPS, TAP, SWH, Calf) as static libraries in
the web build, each with its ladspa_descriptor named after it and listed for the
module's registry (LADSPA_LIBRARIES_BUILT); no -shared, -fPIC or install rules there.

Applies to LMMS v1.3.0-alpha.2 (GPL-2.0-or-later).

diff --git a/plugins/LadspaEffect/CMakeLists.txt b/plugins/LadspaEffect/CMakeLists.txt
index cb5950e..81167e6 100644
--- a/plugins/LadspaEffect/CMakeLists.txt
+++ b/plugins/LadspaEffect/CMakeLists.txt
@@ -8,6 +8,23 @@ SET(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}/ladspa")
 set(CMAKE_C_VISIBILITY_PRESET default)
 set(CMAKE_CXX_VISIBILITY_PRESET default)
 
+# The LADSPA libraries are shared libraries LadspaManager loads, except in the web
+# build: there each is a static library linked into the module, its ladspa_descriptor
+# named after it (<library>_ladspa_descriptor) and listed in LADSPA_LIBRARIES_BUILT for
+# the module's registry.
+IF(LMMS_BUILD_WEB)
+	SET(LADSPA_LIBRARY_TYPE STATIC)
+ELSE()
+	SET(LADSPA_LIBRARY_TYPE MODULE)
+ENDIF()
+
+FUNCTION(LADSPA_LIBRARY_FOR_WEB _target)
+	IF(LMMS_BUILD_WEB)
+		target_compile_definitions("${_target}" PRIVATE "ladspa_descriptor=${_target}_ladspa_descriptor")
+		set_property(GLOBAL APPEND PROPERTY LADSPA_LIBRARIES_BUILT "${_target}")
+	ENDIF()
+ENDFUNCTION()
+
 IF(LMMS_HAVE_CAPS)
 ADD_SUBDIRECTORY(caps)
 ENDIF()
diff --git a/plugins/LadspaEffect/calf/CMakeLists.txt b/plugins/LadspaEffect/calf/CMakeLists.txt
