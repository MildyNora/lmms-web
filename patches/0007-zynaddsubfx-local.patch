-add_subdirectory(zynaddsubfx/src/UI)
+if(NOT LMMS_BUILD_WEB)
+	add_subdirectory(zynaddsubfx/src/UI)
+endif()
 
 add_library(zynaddsubfx_synth OBJECT
     zynaddsubfx/src/DSP/AnalogFilter.cpp
@@ -109,13 +115,17 @@ add_library(zynaddsubfx_synth OBJECT
 )
 
