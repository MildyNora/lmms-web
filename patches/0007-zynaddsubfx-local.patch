+# only the synthesizer and the plugin running it in LMMS's own process (LocalZynAddSubFx)
+if(NOT FLTK_FOUND AND NOT LMMS_BUILD_WEB)
 	return()
 endif()
 
@@ -33,6 +35,7 @@ else()
 	set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -O2 -fpermissive")
 endif()
 
+if(NOT LMMS_BUILD_WEB)
 IF(MINGW_PREFIX)
