lmms-web: Plugins and LADSPA libraries linked in (LMMS_STATIC_PLUGINS): PluginFactory and
LadspaManager read a compiled-in registry the program defines instead of loading
shared libraries with QLibrary.

Applies to LMMS v1.3.0-alpha.2 (GPL-2.0-or-later).

diff --git a/include/LadspaManager.h b/include/LadspaManager.h
index 0d2defa..405c8f8 100644
--- a/include/LadspaManager.h
+++ b/include/LadspaManager.h
@@ -81,6 +81,20 @@ struct LadspaManagerDescription
 	uint16_t outputChannels;
 };
 
+#ifdef LMMS_STATIC_PLUGINS
+//! A LADSPA library linked into the program (the web build): its file name as it
+//! would be loaded elsewhere (e.g. "cmt.so") and its ladspa_descriptor function.
+struct StaticLadspaLibrary
+{
+	const char* fileName;
+	LADSPA_Descriptor_Function descriptorFunction;
+};
+
+//! The LADSPA libraries linked into the program, ending with an entry whose file
+//! name is null. Defined by the program (generated with the list it links).
+extern const StaticLadspaLibrary staticLadspaLibraries[];
+#endif
+
 class LMMS_EXPORT LadspaManager
 {
 public:
