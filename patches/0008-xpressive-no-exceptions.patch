lmms-web: Xpressive without -fexceptions in the web build, which compiles everything without
exception catching (as Qt for WebAssembly is built): objects compiled to catch them wouldn't link
with the rest. Its expression parser only throws on invalid input.

Applies to LMMS v1.3.0-alpha.2 (GPL-2.0-or-later).

diff --git a/plugins/Xpressive/CMakeLists.txt b/plugins/Xpressive/CMakeLists.txt
index 63dc7bc..6890420 100644
--- a/plugins/Xpressive/CMakeLists.txt
+++ b/plugins/Xpressive/CMakeLists.txt
@@ -7,7 +7,11 @@ set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Dexprtk_disable_comments")
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Dexprtk_disable_string_capabilities")
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Dexprtk_disable_rtl_io_file")
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Dexprtk_disable_rtl_vecops")
-set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fexceptions")
+# The web build compiles everything without exception catching, as Qt for WebAssembly is built;
+# objects compiled to catch them wouldn't link with the rest (and valid expressions never throw)
+if(NOT LMMS_BUILD_WEB)
+	set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fexceptions")
+endif()
 
 if (LMMS_BUILD_WIN32 OR LMMS_BUILD_CYGWIN)
 	if (MSVC)
